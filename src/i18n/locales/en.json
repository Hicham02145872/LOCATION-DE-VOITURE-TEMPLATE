  "faq": {
    "badge": "FAQ",
    "title": "Frequently asked questions",
    "subtitle": "Everything you need to know before booking.",
    "questions": [
      {
        "q": "What documents are required to rent?",
        "a": "A valid driver's license held for over a year, a valid ID, and a credit card for the security deposit."
      },
      {
        "q": "How does insurance work?",
        "a": "All our rentals include basic insurance. You can also purchase enhanced coverage at booking for complete peace of mind."
      },
      {
        "q": "Can I change or cancel my reservation?",
        "a": "Yes, cancellation is free up to 48h before the rental starts. Changes are possible subject to availability."
      },
      {
        "q": "Are there extra mileage fees?",
        "a": "Each plan includes a certain number of kilometers per day. Beyond that, a fee of 5 DH/km applies. Premium plans include unlimited mileage."
      },
      {
        "q": "How do I pick up and return the vehicle?",
        "a": "You can pick up your vehicle at one of our 50+ agencies or have it delivered. Return is at the same location unless otherwise specified."
      }
    ]
  },
